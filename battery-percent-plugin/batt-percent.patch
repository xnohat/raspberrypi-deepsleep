+/* MAX17048 fuel-gauge CRATE (charge rate) — used to detect charging on devices
+ * whose battery sysfs exposes no `status` (e.g. HackberryPi CM5). */
+#include <fcntl.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <sys/ioctl.h>
+#include <linux/i2c-dev.h>
+
+/* Returns charge rate in %/hr (signed), or -1000 on error (unknown). */
+static float max17048_crate (void)
+{
+    /* resolve the i2c bus of the *-0036 device (bus number varies across boots) */
+    int bus = -1;
+    DIR *d = opendir ("/sys/bus/i2c/devices");
+    if (d)
+    {
+        struct dirent *e;
+        while ((e = readdir (d)))
+        {
+            int b;
+            if (sscanf (e->d_name, "%d-0036", &b) == 1) { bus = b; break; }
+        }
+        closedir (d);
+    }
+    if (bus < 0) return -1000.0f;
+
+    char path[32];
+    snprintf (path, sizeof (path), "/dev/i2c-%d", bus);
+    int fd = open (path, O_RDWR);
+    if (fd < 0) return -1000.0f;
+
+    float rate = -1000.0f;
+    if (ioctl (fd, I2C_SLAVE_FORCE, 0x36) >= 0)
+    {
+        unsigned char reg = 0x16;                 /* CRATE register */
+        unsigned char buf[2] = {0, 0};
+        if (write (fd, &reg, 1) == 1 && read (fd, buf, 2) == 2)
+        {
+            int raw = (buf[0] << 8) | buf[1];     /* big-endian */
+            if (raw >= 0x8000) raw -= 0x10000;    /* signed */
+            rate = raw * 0.208f;                  /* %/hr per LSB */
+        }
+    }
+    close (fd);
+    return rate;
+}
