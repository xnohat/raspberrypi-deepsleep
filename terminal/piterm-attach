#!/bin/bash
# piterm-attach — each PiTerm window gets its OWN grouped tmux session.
# Grouped sessions share the same windows/panes (state saved by fastboot)
# but each window can view a different tmux window independently.
# Sessions named main, main2, main3... reuse detached ones first.

BASE=main

# no server yet -> create the base session
if ! tmux has-session -t "$BASE" 2>/dev/null; then
    exec tmux new-session -A -s "$BASE"
fi


# cleanup: kill stale detached view sessions (mainN) older than 1h
for st in $(tmux list-sessions -F '#{session_name} #{session_attached} #{session_group} #{session_activity}' 2>/dev/null \
            | awk -v b="$BASE" -v now="$(date +%s)" '$1 != b && $3 == b && $2 == 0 && (now - $4) > 3600 {print $1}'); do
    tmux kill-session -t "$st" 2>/dev/null
done
# reuse a detached session in the group if any
for s in $(tmux list-sessions -F '#{session_name} #{session_attached} #{session_group}' 2>/dev/null \
           | awk -v b="$BASE" '$3 == b || $1 == b {print $1" "$2}' \
           | awk '$2 == 0 {print $1}'); do
    exec tmux attach-session -t "$s"
done

# all attached -> create a new grouped session showing a FRESH shell window
# (otherwise the new view displays the group's current window and looks
# like a mirror of the existing PiTerm window)
i=2
while tmux has-session -t "${BASE}${i}" 2>/dev/null; do i=$((i+1)); done
NEW="${BASE}${i}"
tmux new-session -d -t "$BASE" -s "$NEW"
tmux new-window -t "$NEW" -c "$HOME"
exec tmux attach-session -t "$NEW"
